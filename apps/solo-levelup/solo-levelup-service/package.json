{
  "name": "solo-levelup-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx wrangler dev --remote",
    "build": "bunx wrangler deploy --dry-run --outdir=dist",
    "deploy": "bunx wrangler deploy",
    "drizzle:generate": "bunx drizzle-kit generate",
    "drizzle:studio": "bunx drizzle-kit studio --config=drizzle-dev.config.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json"
  },
  "dependencies": {
    "@apollo/server": "^4.10.0",
    "@as-integrations/cloudflare-workers": "^1.1.0",
    "@clerk/backend": "^1.21.0",
    "drizzle-orm": "^0.33.0",
    "graphql": "^16.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240806.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.24.0",
    "typescript": "~5.5.0",
    "typescript-eslint": "^8.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0"
  }
}
